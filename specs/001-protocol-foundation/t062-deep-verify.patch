+          clang++ --version | head -1
+          wget -q https://github.com/mull-project/mull/releases/download/0.34.0/Mull-18-0.34.0-LLVM-18.1.3-ubuntu-amd64-24.04.deb
+          sudo apt-get install -y ./Mull-18-0.34.0-LLVM-18.1.3-ubuntu-amd64-24.04.deb
+          mull-runner-18 -version
       - name: Focused fuzz (10 min, touched targets)
