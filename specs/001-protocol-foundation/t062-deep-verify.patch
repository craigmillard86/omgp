--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -98,9 +98,9 @@
   deep-verify:
     # Risk-scaled deep testing: T2/T3 PRs run focused fuzz + diff-scoped
     # mutation BEFORE merge (nightly covers the whole repo after).
-    # Dormant until F1 delivers fuzz targets and mutation config — the
-    # tool stubs exit 0 with a notice; F1's acceptance criteria include
-    # making this job bite (see speckit F1 spec).
+    # Live since feature 001: tools/fuzz-smoke.sh runs real libFuzzer targets
+    # and tools/mutate.sh runs Mull (pinned in tools/mutate.cfg) with --require,
+    # so a missing tool fails the job instead of passing silently.
     name: deep-verify (T2/T3 only)
     if: >
       github.event_name == 'pull_request' &&
@@ -110,16 +110,24 @@
     timeout-minutes: 40
     steps:
       - uses: actions/checkout@v4
+        with: {fetch-depth: 0}   # mutate.sh scopes against origin/main; a depth-1 clone has no such ref
       - uses: actions/setup-python@v5
         with: {python-version: '3.12'}
       - name: Deps
         run: |
           sudo apt-get update && sudo apt-get install -y cmake ninja-build clang
           pip install jinja2 pyyaml
+      - name: Mull (mutation testing, pinned per tools/mutate.cfg)
+        run: |
